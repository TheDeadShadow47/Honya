{
  "expo": {
    "name": "Honya",
    "slug": "Honya",
    "version": "1.1.0",
    "scheme": "honya",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "com.example.honya",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.honya"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "047a18d0-2ab7-4c2d-9def-68cf17e23b60"
      }
    }
  }
}
